AGENT_PROVIDER=openrouter
AGENT_MODEL_PRESET=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=code-agent
OPENROUTER_SITE_URL=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA NIM example: set AGENT_PROVIDER=nvidia and AGENT_MODEL_PRESET=glm-5.2.
AGENT_MODEL=qwen/qwen3-coder
AGENT_PROFILE=default
AGENT_PLANNER_MODEL=
AGENT_CODER_MODEL=
AGENT_REVIEWER_MODEL=
AGENT_FAST_MODEL=
# Comma-separated fallback model ids. Registered models infer their provider, so
# this can cross providers when the matching API keys are configured.
AGENT_FALLBACK_MODELS=
AGENT_MAX_TOKENS=4096
AGENT_MODEL_TIMEOUT_SECONDS=60
# Absolute wall-clock deadline for one complete agent run, including model retries.
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MODEL_RETRY_COUNT=2
AGENT_MODEL_RETRY_BASE_SECONDS=0.5
AGENT_MODEL_RETRY_MAX_SECONDS=4
AGENT_MAX_FAILURES=3
AGENT_CONTEXT_MAX_CHARS=60000
AGENT_INPUT_COST_PER_MILLION=
AGENT_OUTPUT_COST_PER_MILLION=
AGENT_DB_PATH=.code-agent/agent.db
AGENT_STREAM=true
AGENT_REVIEWER_PASS=true
# Secure default: project commands cannot access the network unless explicitly enabled.
AGENT_SHELL_NETWORK=deny
AGENT_SANDBOX_BACKEND=auto
AGENT_SANDBOX_IMAGE=python:3.13-slim
AGENT_TRUST_WORKSPACE_EXTENSIONS=false
AGENT_EXECUTION_DB_PATH=.code-agent/executions.db
AGENT_EXECUTION_MODE=shadow
# Independent shadow planner: deterministic (no extra provider call) or model.
AGENT_SHADOW_PLANNER=deterministic
# Reusable container execution is enabled by selecting docker/podman/container above.
AGENT_CONTAINER_WORKSPACE=/workspace
AGENT_CONTAINER_REUSE=true

# Backward-compatible fallback during migration.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
