AGENT_PROVIDER=openrouter
AGENT_MODEL_PRESET=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=code-agent
OPENROUTER_SITE_URL=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

AGENT_MODEL=qwen/qwen3-coder
AGENT_PROFILE=default
AGENT_PLANNER_MODEL=
AGENT_CODER_MODEL=
AGENT_REVIEWER_MODEL=
AGENT_FAST_MODEL=
AGENT_FALLBACK_MODELS=
AGENT_MAX_TOKENS=4096
AGENT_MAX_FAILURES=3
AGENT_INPUT_COST_PER_MILLION=
AGENT_OUTPUT_COST_PER_MILLION=
AGENT_DB_PATH=.code-agent/agent.db
AGENT_STREAM=true
AGENT_REVIEWER_PASS=true
AGENT_SHELL_NETWORK=allow

# Backward-compatible fallback during migration.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
